# teoria-engine — environment variables template
# Copy to the teoria-engine install dir as .env and fill in your values.
#
# Usage:
#   cp teoria-engine/assets/env.example /opt/teoria-engine/.env
#   nano /opt/teoria-engine/.env

# ── Required ──────────────────────────────────────────────────────────────────

# API key enforced by the gateway for all requests (choose a strong random value)
GATEWAY_API_KEY=your-secure-key-here

# HuggingFace token (needed to download gated/private models)
# Get one at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ── Hardware (Linux + NVIDIA only) ────────────────────────────────────────────

# GPU device index to use for vLLM (0-based)
VLLM_GPU_DEVICE=0

# ── Gateway port ──────────────────────────────────────────────────────────────

# Host port the gateway is exposed on (default: 9000)
GATEWAY_PORT=9000

# ── Observability (optional) ──────────────────────────────────────────────────

# OpenObserve dashboard credentials
# OPENOBSERVE_USERNAME=admin
# OPENOBSERVE_PASSWORD=changeme

# ── Agent integration shortcuts ───────────────────────────────────────────────
# Source this file (source .env) then use these in any OpenAI-compatible client:
#
#   OPENAI_BASE_URL=http://localhost:9000/v1
#   OPENAI_API_KEY=$GATEWAY_API_KEY
