#!/usr/bin/env bash
set -euo pipefail

_resolve_path() {
    local target="$1"
    if [[ -L "$target" ]]; then
        if readlink -f "$target" &>/dev/null; then
            readlink -f "$target"
        else
            local dir
            dir="$(cd "$(dirname "$target")" && pwd -P)"
            target="$(readlink "$target")"
            if [[ "$target" != /* ]]; then
                target="$dir/$target"
            fi
            cd "$(dirname "$target")" && echo "$(pwd -P)/$(basename "$target")"
        fi
    else
        echo "$target"
    fi
}

SCRIPT_PATH="$(_resolve_path "${BASH_SOURCE[0]}")"
ENGINE_ROOT="${ENGINE_ROOT:-$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)}"
COMPOSE_FILE="${ENGINE_ROOT}/docker-compose.yml"
ENV_FILE="${ENGINE_ROOT}/.env"
CONFIG_FILE="${ENGINE_ROOT}/config/engine.yml"
SERVICE_NAME="teoria-engine"
SYSTEMD_UNIT="/etc/systemd/system/${SERVICE_NAME}.service"
SYSTEMD_SRC="${ENGINE_ROOT}/systemd/${SERVICE_NAME}.service"
LOAD_CONFIG="${ENGINE_ROOT}/bin/load-config"
MLX_PID_FILE="${ENGINE_ROOT}/.mlx-server.pid"
MLX_LOG_FILE="${ENGINE_ROOT}/.mlx-server.log"

OS="$(uname -s)"
ARCH="$(uname -m)"

_is_linux()  { [[ "$OS" == "Linux" ]]; }
_is_macos()  { [[ "$OS" == "Darwin" ]]; }
_has_nvidia() { command -v nvidia-smi &>/dev/null && docker info 2>/dev/null | grep -q nvidia; }
_is_apple_silicon() { _is_macos && [[ "$ARCH" == "arm64" ]]; }

_write_env_compose() {
    # Writes resolved runtime variables to a Docker Compose env file.
    # Values with spaces or special characters are single-quoted so Compose
    # reads them correctly. Single quotes inside values are escaped as '\''
    local out="$1"
    _q() {
        # Single-quote a value for a .env file: wrap in '', escape internal '
        local val="${1:-}"
        printf "'%s'" "${val//\'/\'\\\'\'}"
    }
    {
        echo "# Auto-generated by bin/teoria-engine — do not edit manually."
        echo "# Regenerated on every 'teoria-engine up / config / preflight'."
        echo "ACTIVE_MODEL=$(_q "${ACTIVE_MODEL:-nemotron}")"
        echo "LOCAL_MODELS_DIR=$(_q "${LOCAL_MODELS_DIR:-}")"
        echo "VLLM_COMMAND=$(_q "${VLLM_COMMAND:-}")"
        echo "VLLM_MODEL=$(_q "${VLLM_MODEL:-}")"
        echo "HF_HUB_OFFLINE=$(_q "${HF_HUB_OFFLINE:-0}")"
        echo "TRANSFORMERS_OFFLINE=$(_q "${TRANSFORMERS_OFFLINE:-0}")"
        echo "GATEWAY_PORT=$(_q "${GATEWAY_PORT:-9000}")"
        echo "GATEWAY_MAX_INPUT_TOKENS=$(_q "${GATEWAY_MAX_INPUT_TOKENS:-8000}")"
        echo "GATEWAY_MAX_OUTPUT_TOKENS=$(_q "${GATEWAY_MAX_OUTPUT_TOKENS:-2000}")"
        echo "GATEWAY_MAX_CONCURRENT_REQUESTS=$(_q "${GATEWAY_MAX_CONCURRENT_REQUESTS:-64}")"
        echo "GATEWAY_CACHE_ENABLED=$(_q "${GATEWAY_CACHE_ENABLED:-true}")"
        echo "GATEWAY_CACHE_MAX_ENTRIES=$(_q "${GATEWAY_CACHE_MAX_ENTRIES:-2048}")"
        echo "GATEWAY_CACHE_TTL=$(_q "${GATEWAY_CACHE_TTL:-3600}")"
        echo "OTEL_ENDPOINT=$(_q "${OTEL_ENDPOINT:-http://otel-collector:4317}")"
        echo "OTEL_SERVICE_NAME=$(_q "${OTEL_SERVICE_NAME:-teoria-engine}")"
    } > "$out"
}

_load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        eval "$(uv run --with pyyaml "$LOAD_CONFIG" "$@")"
        # Write dynamic compose variables to .env.compose so that 'docker compose'
        # can consume them directly (without going through bin/teoria-engine).
        # These are NOT secrets — they're resolved runtime paths and flags.
        # Values are quoted so Docker Compose handles spaces and special chars correctly.
        _write_env_compose "${ENGINE_ROOT}/.env.compose"
    fi
}

_compose() {
    local args=(-f "$COMPOSE_FILE" --project-name "$SERVICE_NAME")
    [[ -f "$ENV_FILE" ]] && args+=(--env-file "$ENV_FILE")
    # .env.compose carries dynamic vars (local model paths, offline flags) resolved
    # by load-config at runtime. Passed as a second env-file so 'docker compose'
    # works correctly even when invoked directly without bin/teoria-engine.
    [[ -f "${ENGINE_ROOT}/.env.compose" ]] && args+=(--env-file "${ENGINE_ROOT}/.env.compose")
    docker compose "${args[@]}" "$@"
}

# ---------------------------------------------------------------------------
# MLX server management (macOS Apple Silicon)
# ---------------------------------------------------------------------------

_mlx_is_running() {
    [[ -f "$MLX_PID_FILE" ]] && kill -0 "$(cat "$MLX_PID_FILE")" 2>/dev/null
}

_mlx_start() {
    # MLX_MODEL is already resolved by load-config:
    #   - local_mlx_path is set → MLX_MODEL = absolute host path to model
    #   - otherwise            → MLX_MODEL = HuggingFace model ID (will download)
    local model="${MLX_MODEL:-}"
    local port="${MLX_PORT:-8000}"
    local host="${MLX_HOST:-0.0.0.0}"

    if [[ -z "$model" ]]; then
        echo "[error] no mlx_name defined for model profile '${ACTIVE_MODEL:-unknown}' in config/engine.yml" >&2
        echo "        add mlx_name to the model profile or switch to a profile that has it" >&2
        return 1
    fi

    if ! command -v mlx_lm.server &>/dev/null; then
        echo "[error] mlx_lm not installed. install it with:" >&2
        echo "        pip install mlx-lm" >&2
        return 1
    fi

    if _mlx_is_running; then
        echo "[teoria-engine] MLX server already running (PID $(cat "$MLX_PID_FILE"))"
        return 0
    fi

    # Show whether we're loading from disk or downloading
    if [[ -n "${MLX_LOCAL_PATH:-}" ]]; then
        echo "[teoria-engine] starting MLX server from local path: ${model}"
    else
        echo "[teoria-engine] starting MLX server (downloading if needed): ${model}"
    fi
    echo "[teoria-engine] MLX server binding: ${host}:${port}"

    # Build mlx_lm.server args — pass HF_HUB_OFFLINE so it doesn't phone home
    # when serving from a local path
    local env_prefix=""
    if [[ "${HF_HUB_OFFLINE:-0}" == "1" ]]; then
        env_prefix="HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1"
    fi

    nohup env ${env_prefix} mlx_lm.server \
        --model "$model" \
        --host "$host" \
        --port "$port" \
        > "$MLX_LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$MLX_PID_FILE"

    echo "[teoria-engine] MLX server starting (PID ${pid}), waiting for health..."
    local ready=false
    for i in $(seq 1 120); do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "[error] MLX server process died. check logs: $MLX_LOG_FILE" >&2
            rm -f "$MLX_PID_FILE"
            tail -20 "$MLX_LOG_FILE" >&2
            return 1
        fi
        if curl -sf "http://localhost:${port}/v1/models" &>/dev/null; then
            ready=true
            break
        fi
        sleep 2
    done

    if $ready; then
        echo "[teoria-engine] MLX server ready (PID ${pid}, model: ${model})"
    else
        echo "[warn] MLX server started but health check timed out after 240s"
        echo "       model may still be downloading/loading. check: tail -f $MLX_LOG_FILE"
    fi
}

_mlx_stop() {
    if _mlx_is_running; then
        local pid
        pid="$(cat "$MLX_PID_FILE")"
        echo "[teoria-engine] stopping MLX server (PID ${pid})"
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        kill -9 "$pid" 2>/dev/null || true
        rm -f "$MLX_PID_FILE"
        echo "[teoria-engine] MLX server stopped"
    else
        rm -f "$MLX_PID_FILE"
    fi
}

_mlx_status() {
    if _mlx_is_running; then
        local pid port
        pid="$(cat "$MLX_PID_FILE")"
        port="${MLX_PORT:-8000}"
        echo "[MLX] running (PID ${pid}, port ${port}, model: ${MLX_MODEL:-unknown})"
        if curl -sf "http://localhost:${port}/v1/models" &>/dev/null; then
            echo "[MLX] health: OK"
        else
            echo "[MLX] health: not responding"
        fi
    else
        echo "[MLX] not running"
    fi
}

_mlx_logs() {
    if [[ -f "$MLX_LOG_FILE" ]]; then
        tail -f "$MLX_LOG_FILE"
    else
        echo "[MLX] no log file found"
    fi
}

# ---------------------------------------------------------------------------
# Determine LLM backend
# ---------------------------------------------------------------------------

_backend() {
    if _has_nvidia; then
        echo "vllm"
    elif _is_apple_silicon; then
        echo "mlx"
    else
        echo "[error] unsupported platform: ${OS}/${ARCH}" >&2
        echo "        teoria-engine requires Linux + NVIDIA GPU or macOS Apple Silicon" >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
    _load_config
    local backend
    backend="$(_backend)"

    echo "[teoria-engine] active model : ${ACTIVE_MODEL:-unknown}"
    echo "[teoria-engine] platform     : ${OS}/${ARCH}"
    echo "[teoria-engine] backend      : ${backend}"

    local profiles=()

    case "$backend" in
        vllm)
            profiles+=(--profile gpu)
            echo "[teoria-engine] NVIDIA runtime detected — vLLM will run locally"
            if [[ -n "${LOCAL_MODELS_DIR:-}" ]]; then
                echo "[teoria-engine] local models dir → ${LOCAL_MODELS_DIR} (mounted at /models/local)"
                echo "[teoria-engine] offline mode     → HF_HUB_OFFLINE=1 (no downloads)"
            else
                echo "[teoria-engine] model source     → HuggingFace (will download if not cached)"
            fi
            ;;
        mlx)
            _mlx_start
            export VLLM_URL="http://host.docker.internal:${MLX_PORT:-8000}"
            export VLLM_MODEL="${MLX_MODEL}"
            echo "[teoria-engine] gateway → ${VLLM_URL} (model: ${MLX_MODEL})"
            ;;
    esac

    if [[ -f "${ENGINE_ROOT}/cloudflared/tunnel.json" ]]; then
        profiles+=(--profile tunnel)
    fi

    _compose "${profiles[@]}" up -d --build
    echo "[teoria-engine] running"
}

cmd_down() {
    _compose --profile gpu --profile tunnel down

    if _is_apple_silicon; then
        _mlx_stop
    fi

    echo "[teoria-engine] stopped"
}

cmd_restart() {
    cmd_down
    cmd_up
}

cmd_logs() {
    if _is_apple_silicon && _mlx_is_running; then
        echo "=== MLX server logs (Ctrl+C then re-run for Docker logs) ==="
        _mlx_logs
    else
        _compose --profile gpu --profile tunnel logs -f --tail="${1:-200}"
    fi
}

cmd_status() {
    _load_config 2>/dev/null || true
    local backend
    backend="$(_backend)"

    echo "=== teoria-engine status ==="
    echo "  platform : ${OS}/${ARCH}"
    echo "  backend  : ${backend}"
    echo ""

    if [[ "$backend" == "mlx" ]]; then
        _mlx_status
        echo ""
    fi

    echo "--- Docker services ---"
    _compose --profile gpu --profile tunnel ps
}

cmd_health() {
    _load_config 2>/dev/null || true
    local port="${GATEWAY_PORT:-9000}"

    if _is_apple_silicon; then
        local mlx_port="${MLX_PORT:-8000}"
        echo -n "mlx server: "
        if _mlx_is_running && curl -sf "http://localhost:${mlx_port}/v1/models" &>/dev/null; then
            echo "healthy"
        else
            echo "unreachable"
        fi
    fi

    echo -n "gateway:    "
    curl -sf "http://localhost:${port}/health" | python3 -m json.tool 2>/dev/null || echo '{"status":"unreachable"}'
}

cmd_config() {
    _load_config "$@"
    local backend
    backend="$(_backend)"

    echo "=== teoria-engine config ==="
    echo "  platform      : ${OS}/${ARCH}"
    echo "  backend       : ${backend}"
    echo "  active model  : ${ACTIVE_MODEL}"
    echo ""

    if [[ "$backend" == "vllm" ]]; then
        echo "  --- vLLM (Linux + NVIDIA GPU) ---"
        if [[ -n "${VLLM_LOCAL_PATH:-}" ]]; then
            echo "  model source  : LOCAL (${VLLM_LOCAL_PATH})"
            echo "  container path: /models/local/$(realpath --relative-to="${LOCAL_MODELS_DIR:-/}" "${VLLM_LOCAL_PATH}" 2>/dev/null || echo "${VLLM_LOCAL_PATH}")"
            echo "  hf fallback   : ${VLLM_MODEL}"
        else
            echo "  model source  : HuggingFace"
            echo "  hf name       : ${VLLM_MODEL}"
        fi
        echo "  local dir     : ${LOCAL_MODELS_DIR:-(not set)}"
        echo "  max model len : ${VLLM_MAX_MODEL_LEN}"
        echo "  gpu mem util  : ${VLLM_GPU_MEMORY_UTILIZATION}"
        echo "  max seqs      : ${VLLM_MAX_NUM_SEQS}"
        echo "  batch tokens  : ${VLLM_MAX_NUM_BATCHED_TOKENS}"
        echo "  prefix cache  : ${VLLM_ENABLE_PREFIX_CACHING}"
        echo "  chunked fill  : ${VLLM_ENABLE_CHUNKED_PREFILL}"
        echo "  vllm command  : ${VLLM_COMMAND}"
    fi

    if [[ "$backend" == "mlx" ]]; then
        echo "  --- MLX (macOS + Apple Silicon) ---"
        if [[ -n "${MLX_LOCAL_PATH:-}" ]]; then
            echo "  model source  : LOCAL (${MLX_LOCAL_PATH})"
        else
            echo "  model source  : HuggingFace"
        fi
        echo "  mlx model     : ${MLX_MODEL:-not configured}"
        echo "  local dir     : ${LOCAL_MODELS_DIR:-(not set)}"
        echo "  mlx host:port : ${MLX_HOST:-0.0.0.0}:${MLX_PORT:-8000}"
    fi

    echo ""
    echo "  --- Gateway ---"
    echo "  gateway port  : ${GATEWAY_PORT}"
}

cmd_service_install() {
    if _is_macos; then
        echo "[error] systemd services are not supported on macOS" >&2
        echo "        use 'teoria-engine up' to run, or create a launchd plist manually" >&2
        exit 1
    fi
    if [[ $EUID -ne 0 ]]; then
        echo "[error] must run as root to install systemd service" >&2
        exit 1
    fi
    local real_root
    real_root="$(cd "$ENGINE_ROOT" && pwd)"
    sed "s|__ENGINE_ROOT__|${real_root}|g; s|__ENGINE_BIN__|${real_root}/bin/teoria-engine|g" \
        "$SYSTEMD_SRC" > "$SYSTEMD_UNIT"
    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME"
    systemctl start "$SERVICE_NAME"
    echo "[teoria-engine] systemd service installed and started"
    systemctl status "$SERVICE_NAME" --no-pager
}

cmd_service_uninstall() {
    if _is_macos; then
        echo "[error] systemd services are not supported on macOS" >&2
        exit 1
    fi
    if [[ $EUID -ne 0 ]]; then
        echo "[error] must run as root" >&2
        exit 1
    fi
    systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl disable "$SERVICE_NAME" 2>/dev/null || true
    rm -f "$SYSTEMD_UNIT"
    systemctl daemon-reload
    echo "[teoria-engine] systemd service removed"
}

cmd_uninstall() {
    echo "=== teoria-engine uninstall ==="
    echo ""
    echo "This will:"
    echo "  1. Stop and remove all containers and volumes"
    if _is_apple_silicon; then
        echo "  2. Stop MLX server"
    fi
    if _is_linux; then
        echo "  2. Remove systemd service (if installed)"
    fi
    echo "  3. Remove /usr/local/bin/teoria-engine symlink"
    echo "  4. Remove $ENGINE_ROOT"
    echo ""
    read -r -p "Are you sure? [y/N] " ans
    if [[ "${ans,,}" != "y" ]]; then
        echo "Aborted."
        return
    fi

    cmd_down 2>/dev/null || true
    _compose --profile gpu --profile tunnel down -v --remove-orphans 2>/dev/null || true

    if _is_linux; then
        if [[ $EUID -eq 0 ]]; then
            cmd_service_uninstall 2>/dev/null || true
        elif systemctl is-enabled "$SERVICE_NAME" &>/dev/null; then
            echo "[warn] systemd service exists — run with sudo to remove it"
        fi
    fi

    rm -f /usr/local/bin/teoria-engine 2>/dev/null || sudo rm -f /usr/local/bin/teoria-engine 2>/dev/null || true

    if [[ -d "$ENGINE_ROOT" ]]; then
        rm -rf "$ENGINE_ROOT"
        echo "[ok] removed $ENGINE_ROOT"
    fi

    echo ""
    echo "[teoria-engine] uninstalled"
}

cmd_preflight() {
    local ok=true
    _load_config 2>/dev/null || true
    local backend
    backend="$(_backend)"

    echo "=== teoria-engine preflight ==="
    echo "  platform : ${OS}/${ARCH}"
    echo "  backend  : ${backend}"
    echo ""

    if ! command -v docker &>/dev/null; then
        echo "[FAIL] docker not found"; ok=false
    else
        echo "[OK]   docker $(docker --version | awk '{print $3}')"
    fi

    if ! docker compose version &>/dev/null; then
        echo "[FAIL] docker compose plugin not found"; ok=false
    else
        echo "[OK]   docker compose $(docker compose version --short)"
    fi

    case "$backend" in
        vllm)
            if command -v nvidia-smi &>/dev/null; then
                echo "[OK]   nvidia-smi detected"
                nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true
            fi
            if docker info 2>/dev/null | grep -q nvidia; then
                echo "[OK]   nvidia container runtime"
            else
                echo "[WARN] nvidia runtime not detected in docker"
            fi
            ;;
        mlx)
            echo "[OK]   Apple Silicon detected (${ARCH})"
            if command -v mlx_lm.server &>/dev/null; then
                echo "[OK]   mlx-lm installed"
            else
                echo "[FAIL] mlx-lm not installed — run: pip install mlx-lm"; ok=false
            fi
            local mlx_model="${MLX_MODEL:-}"
            if [[ -n "$mlx_model" ]]; then
                echo "[OK]   MLX model configured: ${mlx_model}"
            else
                echo "[FAIL] no mlx_name defined for model '${ACTIVE_MODEL:-unknown}' in config/engine.yml"; ok=false
            fi
            ;;
    esac

    if [[ ! -f "$ENV_FILE" ]]; then
        echo "[WARN] .env not found — run: cp .env.example .env"
    else
        echo "[OK]   .env present"
    fi

    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "[FAIL] config/engine.yml not found"; ok=false
    else
        echo "[OK]   config/engine.yml present"
        echo "       active model: ${ACTIVE_MODEL:-unknown} (backend: ${backend})"
    fi

    # Local models directory check
    echo ""
    echo "--- Local model cache ---"
    if [[ -n "${LOCAL_MODELS_DIR:-}" ]]; then
        if [[ -d "${LOCAL_MODELS_DIR}" ]]; then
            local model_count
            model_count=$(find "${LOCAL_MODELS_DIR}" -maxdepth 3 \
                \( -name "*.safetensors" -o -name "*.gguf" \) 2>/dev/null | wc -l | tr -d ' ')
            echo "[OK]   local_models_dir: ${LOCAL_MODELS_DIR}"
            echo "       model files found: ${model_count} (.safetensors + .gguf)"
        else
            echo "[WARN] local_models_dir '${LOCAL_MODELS_DIR}' does not exist"
        fi
    else
        # Check LM Studio defaults
        local lm_linux="$HOME/.cache/lm-studio/models"
        local lm_mac="$HOME/.lmstudio/models"
        if [[ -d "$lm_linux" ]]; then
            echo "[INFO] LM Studio detected at: ${lm_linux}"
            echo "       To use it, add to config/engine.yml:"
            echo "         local_models_dir: ${lm_linux}"
        elif [[ -d "$lm_mac" ]]; then
            echo "[INFO] LM Studio detected at: ${lm_mac}"
            echo "       To use it, add to config/engine.yml:"
            echo "         local_models_dir: ${lm_mac}"
        else
            echo "[INFO] local_models_dir not configured (models will download from HuggingFace)"
        fi
    fi

    # Per-model local path check
    if [[ -n "${VLLM_LOCAL_PATH:-}" ]]; then
        echo "[OK]   vLLM local path: ${VLLM_LOCAL_PATH}"
    fi
    if [[ -n "${MLX_LOCAL_PATH:-}" ]]; then
        echo "[OK]   MLX local path:  ${MLX_LOCAL_PATH}"
    fi

    echo ""
    $ok && echo "=== preflight passed ===" || echo "=== preflight has warnings ==="
}

cmd_help() {
    cat <<EOF
teoria-engine — LLM inference deployment manager

Usage: teoria-engine <command> [options]

Commands:
  up                    Start all services
  down                  Stop all services
  restart               Restart all services
  logs [N]              Follow logs (last N lines, default 200)
  status                Show container status
  health                Check health (gateway + LLM backend)
  config [--model X]    Show resolved configuration
  preflight             Check system prerequisites
  help                  Show this message
EOF

    if _is_linux; then
        cat <<EOF

Linux-only:
  service               Install as systemd service (requires root)
  unservice             Remove systemd service (requires root)
EOF
    fi

    cat <<EOF

Model override:
  teoria-engine config --model qwen-0.5b

Supported platforms:
  Linux + NVIDIA GPU  →  vLLM (Docker, CUDA)
  macOS Apple Silicon →  MLX  (native, Metal)
EOF
}

case "${1:-help}" in
    up)          cmd_up ;;
    down)        cmd_down ;;
    restart)     cmd_restart ;;
    logs)        cmd_logs "${2:-}" ;;
    status)      cmd_status ;;
    health)      cmd_health ;;
    config)      shift; cmd_config "$@" ;;
    service)     cmd_service_install ;;
    unservice)   cmd_service_uninstall ;;
    preflight)   cmd_preflight ;;
    uninstall)   cmd_uninstall ;;
    help|--help) cmd_help ;;
    *)           echo "[error] unknown command: $1" >&2; cmd_help; exit 1 ;;
esac
