#!/usr/bin/env python3
"""
Parse config/engine.yml and emit shell-compatible environment variables.

Usage (sourced by teoria-engine):
    eval "$(bin/load-config)"
    eval "$(bin/load-config --model qwen-0.5b)"   # override active model
"""

import sys
import os
import pathlib

try:
    import yaml
except ImportError:
    sys.exit("pyyaml is required: uv pip install pyyaml")


# ---------------------------------------------------------------------------
# Local path resolution helpers
# ---------------------------------------------------------------------------

# Default LM Studio model cache locations per platform
_LM_STUDIO_DEFAULTS = {
    "Darwin": pathlib.Path.home() / ".lmstudio" / "models",
    "Linux":  pathlib.Path.home() / ".cache" / "lm-studio" / "models",
}


def _expand(raw: str) -> pathlib.Path:
    """Expand ~ and env vars, return absolute Path."""
    return pathlib.Path(os.path.expandvars(os.path.expanduser(raw))).resolve()


def _resolve_local_models_dir(cfg: dict) -> pathlib.Path | None:
    """
    Return the resolved local_models_dir, or None when not configured.
    Falls back to the LM Studio default path when it exists on disk.
    """
    raw = cfg.get("local_models_dir")
    if raw:
        p = _expand(str(raw))
        if not p.exists():
            print(
                f"[warn] local_models_dir '{p}' does not exist — ignoring",
                file=sys.stderr,
            )
            return None
        return p

    # Auto-detect LM Studio default
    import platform
    default = _LM_STUDIO_DEFAULTS.get(platform.system())
    if default and default.exists():
        print(
            f"[info] auto-detected LM Studio model cache: {default}",
            file=sys.stderr,
        )
        return default

    return None


def _resolve_model_local_path(
    model: dict,
    base_dir: pathlib.Path | None,
    field: str,
) -> pathlib.Path | None:
    """
    Resolve a model-level local path field (local_path or local_mlx_path).
    Returns the absolute host path, or None if not configured / not found.
    """
    raw = model.get(field)
    if not raw:
        return None

    raw_path = pathlib.Path(str(raw))

    # Absolute path → use as-is
    if raw_path.is_absolute():
        p = raw_path.resolve()
    elif base_dir:
        p = (base_dir / raw_path).resolve()
    else:
        print(
            f"[warn] {field} '{raw}' is relative but local_models_dir is not set — ignoring",
            file=sys.stderr,
        )
        return None

    if not p.exists():
        print(
            f"[warn] {field} path '{p}' does not exist on disk — falling back to HuggingFace",
            file=sys.stderr,
        )
        return None

    return p


def load(config_path: str, model_override: str | None = None) -> dict[str, str]:
    with open(config_path) as f:
        cfg = yaml.safe_load(f)

    active = model_override or cfg.get("active_model", "nemotron")
    model = cfg.get("models", {}).get(active)
    if not model:
        available = ", ".join(cfg.get("models", {}).keys())
        sys.exit(f"model profile '{active}' not found. available: {available}")

    # Gateway: global defaults → model-level overrides (model takes precedence)
    gw_global = cfg.get("gateway", {})
    gw_model = model.get("gateway", {})
    gw = {**gw_global, **{k: v for k, v in gw_model.items() if k != "cache"}}
    gw_cache = {**gw_global.get("cache", {}), **gw_model.get("cache", {})}

    obs = cfg.get("observability", {})
    mlx_cfg = cfg.get("mlx", {})

    # -------------------------------------------------------------------------
    # Local model path resolution
    # -------------------------------------------------------------------------
    local_models_dir = _resolve_local_models_dir(cfg)

    # vLLM: local_path (must be HF SafeTensors format, GGUF not supported by vLLM)
    vllm_local = _resolve_model_local_path(model, local_models_dir, "local_path")

    # MLX: local_mlx_path (supports HF format and GGUF files)
    mlx_local = _resolve_model_local_path(model, local_models_dir, "local_mlx_path")

    # The model identifier passed to vLLM: local container path takes priority
    # Container-side path is /models/local/<relative_path_within_local_models_dir>
    if vllm_local and local_models_dir:
        try:
            rel = vllm_local.relative_to(local_models_dir)
            vllm_model_arg = f"/models/local/{rel}"
        except ValueError:
            # Absolute path outside local_models_dir — can't bind-mount reliably
            print(
                f"[warn] local_path '{vllm_local}' is not under local_models_dir '{local_models_dir}' "
                "— using HuggingFace name instead",
                file=sys.stderr,
            )
            vllm_local = None
            vllm_model_arg = model["hf_name"]
    else:
        vllm_model_arg = model["hf_name"]

    # MLX model: local host path takes priority over HF name
    mlx_model_resolved = str(mlx_local) if mlx_local else model.get("mlx_name", "")

    # -------------------------------------------------------------------------
    # vLLM command construction
    # -------------------------------------------------------------------------
    vllm_flags = [f"--model {vllm_model_arg}"]
    if model.get("trust_remote_code", False):
        vllm_flags.append("--trust-remote-code")
    vllm_flags.append(f"--gpu-memory-utilization {model.get('gpu_memory_utilization', 0.95)}")
    vllm_flags.append(f"--max-model-len {model.get('max_model_len', 131072)}")
    vllm_flags.append(f"--max-num-seqs {model.get('max_num_seqs', 256)}")
    vllm_flags.append(f"--max-num-batched-tokens {model.get('max_num_batched_tokens', 8192)}")
    if model.get("prefix_caching", True):
        vllm_flags.append("--enable-prefix-caching")
    if model.get("chunked_prefill", True):
        vllm_flags.append("--enable-chunked-prefill")
    if model.get("enable_auto_tool_choice", False):
        vllm_flags.append("--enable-auto-tool-choice")
        parser = model.get("tool_call_parser", "llama3_json")
        vllm_flags.append(f"--tool-call-parser {parser}")
    if model.get("enforce_eager", False):
        vllm_flags.append("--enforce-eager")
    if model.get("async_scheduling", False):
        vllm_flags.append("--async-scheduling")
    extra = model.get("vllm_extra_args", "").strip()
    if extra:
        vllm_flags.append(extra)

    env: dict[str, str] = {
        "ACTIVE_MODEL": active,
        # vLLM
        "VLLM_MODEL": vllm_model_arg,
        "VLLM_COMMAND": " ".join(vllm_flags),
        "VLLM_GPU_MEMORY_UTILIZATION": str(model.get("gpu_memory_utilization", 0.95)),
        "VLLM_MAX_MODEL_LEN": str(model.get("max_model_len", 131072)),
        "VLLM_MAX_NUM_SEQS": str(model.get("max_num_seqs", 256)),
        "VLLM_MAX_NUM_BATCHED_TOKENS": str(model.get("max_num_batched_tokens", 8192)),
        "VLLM_ENABLE_PREFIX_CACHING": str(model.get("prefix_caching", True)).lower(),
        "VLLM_ENABLE_CHUNKED_PREFILL": str(model.get("chunked_prefill", True)).lower(),
        # MLX
        "MLX_MODEL": mlx_model_resolved,
        "MLX_PORT": str(mlx_cfg.get("port", 8000)),
        "MLX_HOST": mlx_cfg.get("host", "0.0.0.0"),
        # Gateway
        "GATEWAY_PORT": str(gw.get("port", 9000)),
        "GATEWAY_MAX_INPUT_TOKENS": str(gw.get("max_input_tokens", 8000)),
        "GATEWAY_MAX_OUTPUT_TOKENS": str(gw.get("max_output_tokens", 2000)),
        "GATEWAY_MAX_CONCURRENT_REQUESTS": str(gw.get("max_concurrent_requests", 64)),
        "GATEWAY_CACHE_ENABLED": str(gw_cache.get("enabled", True)).lower(),
        "GATEWAY_CACHE_MAX_ENTRIES": str(gw_cache.get("max_entries", 2048)),
        "GATEWAY_CACHE_TTL": str(gw_cache.get("ttl_seconds", 3600)),
        "OTEL_ENDPOINT": obs.get("otel_endpoint", "http://otel-collector:4317"),
        "OTEL_SERVICE_NAME": obs.get("service_name", "teoria-engine"),
        # Local model paths (empty string when not used)
        "LOCAL_MODELS_DIR": str(local_models_dir) if local_models_dir else "",
        "VLLM_LOCAL_PATH": str(vllm_local) if vllm_local else "",
        "MLX_LOCAL_PATH": str(mlx_local) if mlx_local else "",
        # Offline mode: prevent accidental HF downloads when using local paths
        "HF_HUB_OFFLINE": "1" if (vllm_local or mlx_local) else "0",
        "TRANSFORMERS_OFFLINE": "1" if (vllm_local or mlx_local) else "0",
    }
    return env


def write_cloudflared_config(config_path: str, out_path: str) -> None:
    """Generate cloudflared/config.yml from config/engine.yml tunnel section."""
    with open(config_path) as f:
        cfg = yaml.safe_load(f)
    tunnel = cfg.get("tunnel", {})
    tunnel_ref = tunnel.get("id") or tunnel.get("name", "llm-server")
    hostname = tunnel.get("hostname", "llm.jambu.ai")
    content = f"""# Generated from config/engine.yml tunnel section — version with project
tunnel: {tunnel_ref}
credentials-file: /etc/cloudflared/tunnel.json

ingress:
  - hostname: {hostname}
    service: http://nginx:80
  - service: http_status:404
"""
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w") as f:
        f.write(content)


def main():
    root = os.path.normpath(os.path.join(os.path.dirname(__file__), ".."))
    config_path = os.path.join(root, "config", "engine.yml")
    cloudflared_config = os.path.join(root, "cloudflared", "config.yml")

    if "install-cloudflared-config" in sys.argv:
        if not os.path.exists(config_path):
            sys.exit(f"config not found: {config_path}")
        write_cloudflared_config(config_path, cloudflared_config)
        print(f"[ok] wrote {cloudflared_config}")
        return

    model_override = None
    for i, arg in enumerate(sys.argv[1:], 1):
        if arg == "--model" and i < len(sys.argv) - 1:
            model_override = sys.argv[i + 1]
        elif arg.startswith("--model="):
            model_override = arg.split("=", 1)[1]
        elif arg == "--config" and i < len(sys.argv) - 1:
            config_path = sys.argv[i + 1]

    if not os.path.exists(config_path):
        sys.exit(f"config not found: {config_path}")

    env = load(config_path, model_override)
    for key, val in env.items():
        print(f'export {key}="{val}"')


if __name__ == "__main__":
    main()
