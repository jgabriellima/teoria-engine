# =============================================================================
# teoria-engine secrets and environment-specific values
# Application config lives in config/engine.yml
# Copy to .env and edit: cp .env.example .env
# =============================================================================

# --- Secrets -----------------------------------------------------------------
GATEWAY_API_KEY=CHANGE_ME
HUGGINGFACE_TOKEN=

# --- Hardware (environment-specific) -----------------------------------------
VLLM_GPU_DEVICE=0

# --- Cloudflare Tunnel -------------------------------------------------------
# One-time: run bin/setup-tunnel to create tunnel and cloudflared/tunnel.json.
# Deploy: copy cloudflared/tunnel.json to VM at /opt/teoria-engine/cloudflared/
