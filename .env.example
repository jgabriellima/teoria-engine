# =============================================================================
# teoria-engine — environment variables
# Copy to .env and edit: cp .env.example .env
#
# Application config (models, gateway, tunnel, etc.) lives in config/engine.yml
# This file is ONLY for secrets and hardware-specific values.
#
# Supported platforms:
#   Linux + NVIDIA GPU  →  vLLM (Docker, CUDA)
#   macOS Apple Silicon →  MLX  (native, Metal)
# =============================================================================

# --- Secrets (required) ------------------------------------------------------
GATEWAY_API_KEY=default
HUGGINGFACE_TOKEN=

# --- Hardware (Linux only) ---------------------------------------------------
VLLM_GPU_DEVICE=0

# --- OpenObserve (observability dashboard) -----------------------------------
OBS_USER=admin@teoria.ai
OBS_PASSWORD=CHANGE_ME
OBS_OTEL_AUTH=   # base64(OBS_USER:OBS_PASSWORD) — generate: echo -n "email:pass" | base64
