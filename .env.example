# =============================================================================
# teoria-engine configuration
# Copy to .env and edit before running: cp .env.example .env
# =============================================================================

# --- vLLM -------------------------------------------------------------------
VLLM_MODEL=nvidia/nemotron-3-nano-4b
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_SEQS=256
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_GPU_DEVICE=0

# --- HuggingFace (required for gated models) --------------------------------
HUGGINGFACE_TOKEN=

# --- Gateway -----------------------------------------------------------------
GATEWAY_API_KEY=default
GATEWAY_PORT=9000
GATEWAY_MAX_INPUT_TOKENS=8000
GATEWAY_MAX_OUTPUT_TOKENS=2000
GATEWAY_MAX_CONCURRENT_REQUESTS=64
GATEWAY_WORKERS=4

# --- NGINX -------------------------------------------------------------------
NGINX_RATE_LIMIT=5r/s
NGINX_BURST=20

# --- Cloudflare Tunnel -------------------------------------------------------
# Place your tunnel credentials at cloudflared/tunnel.json
CF_TUNNEL_NAME=llm-server
CF_HOSTNAME=llm.jambu.ai

# --- OpenTelemetry -----------------------------------------------------------
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=teoria-engine

# --- OpenObserve (observability dashboard) -----------------------------------
OBS_USER=admin@teoria.ai
OBS_PASSWORD=CHANGE_ME
OBS_OTEL_AUTH=   # base64(OBS_USER:OBS_PASSWORD) — generate: echo -n "email:pass" | base64

# --- Paths (usually no need to change) ---------------------------------------
ENGINE_ROOT=/opt/teoria-engine
